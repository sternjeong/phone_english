# Copy this file to .env.local and fill in your values.

# Gemini — get a key from https://aistudio.google.com/apikey
# GEMINI_API_KEY_2 is optional — a second key (ideally from a different
# Google account/project) roughly doubles the effective daily quota, since
# src/lib/gemini.ts fails over across models AND keys on 429/503.
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_MODEL=gemini-3.6-flash

# Auth — NextAuth.js, single-user passcode login (no OAuth console setup).
# AUTH_SECRET: generate with `npx auth secret` (or any random string).
# AUTH_PASSCODE: whatever password you want to log in with.
AUTH_SECRET=
AUTH_PASSCODE=

# Database — Vercel Postgres. Vercel injects this automatically once you
# provision Postgres and link the project; for local dev, paste the
# connection string from the Vercel dashboard (Storage → your DB → .env.local tab).
POSTGRES_URL=
